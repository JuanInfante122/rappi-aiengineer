# Copy this file to secrets.toml and fill in your credentials.
# secrets.toml is gitignored — never commit real keys.

OPENAI_API_KEY = "sk-your-key-here"

# SMTP settings for email report delivery (optional — app works without them)
SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = "587"
SMTP_USER     = "your_email@gmail.com"
SMTP_PASSWORD = "your_app_password"
# SMTP_FROM   = "your_email@gmail.com"  # optional, defaults to SMTP_USER
