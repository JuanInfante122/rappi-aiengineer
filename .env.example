# OpenAI
OPENAI_API_KEY=your_key_here

# SMTP — email delivery for the weekly HTML report (optional)
# Leave blank to disable email sending; the download button still works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_app_password
# SMTP_FROM is optional — defaults to SMTP_USER if not set
# SMTP_FROM=Rappi Ops Intelligence <reports@yourdomain.com>
